.env
# Next.js reads web/.env.local in dev; it holds the Google client secret.
.env*.local
node_modules/
.next/
__pycache__/
*.pyc
.venv/
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/*.tfvars
*.pem
*.tsbuildinfo
# Written by `next dev` (Next 16) on every start, pointing AI coding tools at
# Next's bundled docs. Regenerated each time, so not ours to version.
web/AGENTS.md
web/CLAUDE.md

# The training data is 5.7 MB and recoverable: tg_model.fetch_data() pulls it
# back from Zenodo. tg_model.pkl is NOT ignored, even though it is a build
# artefact -- the deploy builds the image on the box from a fresh checkout, so
# anything not committed here simply does not exist in production, and without
# the pickle the designer silently falls back to the backbone handbook table.
tg_data.csv
measurements.db
campaigns.db
