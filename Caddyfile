# SITE_ADDRESS comes from .env via docker-compose.
#   SITE_ADDRESS=:80                 -> plain HTTP, fine for a bare EC2 IP
#   SITE_ADDRESS=screen.example.com  -> Caddy gets a Let's Encrypt cert on its own
{$SITE_ADDRESS::80} {
	# The API, under its own prefix, which is stripped before it reaches it
	# (/_api/design/iterate arrives as /design/iterate). The web's pages have the
	# same names as API routes -- /screen, /design, /history -- so the API cannot
	# share the root with them: NEXT_PUBLIC_API_URL is https://<domain>/_api.
	handle_path /_api/* {
		reverse_proxy api:8000
	}
	# At the root as well, for callers that are not the web app: the deploy's
	# health check, and the simulation worker on a rented GPU, whose API_URL is
	# the bare domain. The queue is token-protected by the API itself.
	handle /health {
		reverse_proxy api:8000
	}
	handle /worker* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
}
