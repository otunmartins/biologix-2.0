# SITE_ADDRESS comes from .env via docker-compose.
#   SITE_ADDRESS=:80                 -> plain HTTP, fine for a bare EC2 IP
#   SITE_ADDRESS=screen.example.com  -> Caddy gets a Let's Encrypt cert on its own
{$SITE_ADDRESS::80} {
	handle /screen* {
		reverse_proxy api:8000
	}
	# The polymer designer and its active-learning campaign endpoints:
	# /design, /design/iterate, /design/queue, /design/campaign/<id>. Without the
	# wildcard these fall through to the web container and 404, which looks like a
	# broken designer rather than a missing route.
	handle /design* {
		reverse_proxy api:8000
	}
	handle /health {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
}
