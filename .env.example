# Copy to .env on the instance (or locally) and fill in.
# NEVER put a real key in this file — it is committed; .env is not.
ANTHROPIC_API_KEY=sk-ant-...

# Postgres. Campaigns and measurements live here; without it /health reports
# database.reachable false and every design iteration fails.
#
# Neon publishes TWO strings and they are not interchangeable:
#   DATABASE_URL        the POOLED one (host contains "-pooler") — the app
#   DIRECT_DATABASE_URL the direct one — prisma migrate, which needs a real
#                       session and cannot run through the pooler
# Locally, one docker Postgres serves both:
#   docker run -d --name biologix-pg -e POSTGRES_PASSWORD=devpass \
#     -e POSTGRES_USER=biologix -e POSTGRES_DB=biologix -p 5432:5432 postgres:16
DATABASE_URL=postgresql://biologix:devpass@localhost:5432/biologix
DIRECT_DATABASE_URL=postgresql://biologix:devpass@localhost:5432/biologix

# Where the test suite creates and drops its own tables. Point this at a separate
# Neon BRANCH (or a second local database) — never at the one above, since the
# tests drop what they create.
TEST_DATABASE_URL=postgresql://biologix:devpass@localhost:5432/biologix_test

# Optional but recommended: free from https://open.fda.gov/apis/authentication/
# Without it openFDA allows ~1,000 requests/day per IP, and one excipient
# lookup can use ten.
OPENFDA_API_KEY=

# Bare IP over HTTP — swap all three for your domain once DNS points at the box:
#   SITE_ADDRESS=screen.example.com
#   WEB_ORIGIN=https://screen.example.com
#   NEXT_PUBLIC_API_URL=https://screen.example.com
SITE_ADDRESS=:80
WEB_ORIGIN=http://<the-ec2-public-ip>
NEXT_PUBLIC_API_URL=http://<the-ec2-public-ip>
