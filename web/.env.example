# PostHog browser analytics. Copy to web/.env.local for `next dev`; the
# deployed site gets this baked into its bundle at image build time instead,
# from the repository secret POSTHOG_PROJECT_TOKEN (.github/workflows/deploy.yml).
# Empty is a supported state: posthog-js never starts and nothing is reported.
#
# PostHog > Settings > Project > Project API key. It starts phc_ and can only
# write events, which is why it may live in the client bundle. The phx_
# (personal) and phs_ (project secret) keys shown nearby on that page are real
# credentials; the build refuses anything that is not phc_ (next.config.ts).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# Leave this unset. The browser talks to this app at /_ph, which next.config.ts
# forwards to PostHog, so that tracker blocking does not quietly remove a share
# of every number. Setting it to an absolute URL bypasses that proxy.
#   NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
#
# The project is on EU cloud, which is the built-in default. These are needed
# only to point the app at a US or self-hosted project instead:
#   NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
#   POSTHOG_INGEST_HOST=https://us.i.posthog.com
#   POSTHOG_ASSETS_HOST=https://us-assets.i.posthog.com
